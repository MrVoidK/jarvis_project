# Python virtual environment 
venv/
env/

# cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# temporary audio files and logs
*.wav
*.mp3
*.log

# Mouth (XTTS-v2) voice-cloning reference samples are required assets, not
# temporary output - tracked despite the blanket *.wav rule above so the
# repo is runnable after a fresh clone (see tts_handler.py REFERENCE_AUDIO_*).
!jarvis_reference.wav
!jarvis_reference_tr.wav

# Environment variables
.env
secrets/

# Spotify OAuth token cache (spotipy) - refresh token iceriyor, .env ile ayni hassasiyet
.spotify_cache

# Kullanici verisi - Jarvis'in kaydettigi notlar ve arac calisma dizini
# (.env ile ayni mantik: kisisel, makineye ozel, repoya girmemeli)
notes/
jarvis_workspace/

# Operating System Remnants
Thumbs.db
.DS_Store