# Python virtual environment 
venv/
env/

# cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# temporary audio files and logs
*.wav
*.mp3
*.log

# Mouth (XTTS-v2) voice-cloning reference samples are required assets, not
# temporary output - tracked despite the blanket *.wav rule above so the
# repo is runnable after a fresh clone (see tts_handler.py REFERENCE_AUDIO_*).
!jarvis_reference.wav
!jarvis_reference_tr.wav

# Environment variables
.env
secrets/

# Kisisel guvenlik yapilandirmasi (allowed_directories, known_applications) -
# gercek Obsidian vault yolu gibi makineye ozel bilgi icerir, sablon icin
# bkz. config/security.example.yaml (bu commit'lenir).
config/security.yaml

# Faz 6.6 execution modes - kisisel zamanlanmis gorevler/izleyiciler; sablon
# icin bkz. config/scheduled_tasks.example.yaml (bu commit'lenir). security.yaml
# gibi OPSIYONEL: yoksa ozellik sessizce kapali.
config/scheduled_tasks.yaml

# MCP sunucu yapilandirmasi - kisisel/makineye ozel yollar icerebilir
# (orn. Obsidian vault yolu), sablon icin bkz. config/mcp_servers.example.yaml.
# security.yaml'in aksine OPSIYONEL: yoksa MCP katmani sadece devre disi
# kalir, uygulama cokmez (bkz. src/jarvis/core/mcp_config.py).
config/mcp_servers.yaml

# Kullanici verisi - Jarvis'in kaydettigi notlar ve arac calisma dizini
# (.env ile ayni mantik: kisisel, makineye ozel, repoya girmemeli)
notes/
jarvis_workspace/

# Merkezi SQLite veritabani - kalici semantic hafiza (Faz 6.5) + yapisal
# veri (Faz 6.5.1: traces, tasks, ...). Kisisel konusma icerigi + embedding'ler.
# WAL yan dosyalari dahil. Sema migrations/ altinda commit'lenir; veri girmez.
data/

# Operating System Remnants
Thumbs.db
.DS_Store